# Copy to .env (git-ignored) and fill in. `scry` loads ./.env at startup; variables already set in the
# environment take precedence. Keep the file private: chmod 600 .env
ANTHROPIC_API_KEY=
# Optional, only for the outline stage (`uv sync --extra outline`). The stage passes this key to the Google SDK itself:
# left alone, the SDK takes GOOGLE_API_KEY first when both are set.
# GEMINI_API_KEY=
